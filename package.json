{
	"name": "@kikopalomares/is-audio",
	"version": "0.1.0",
	"type": "module",
	"author": {
		"name": "Kiko Palomares",
		"email": "info@kikopalomares.com",
		"url": "https://kikopalomares.com"
	},
	"description": "Check if a filepath is an audio file",
	"license": "MIT",
	"main": "./index.cjs",
	"module": "./index.js",
	"types": "./index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./index.d.ts",
				"default": "./index.js"
			},
			"require": {
				"types": "./index.d.cts",
				"default": "./index.cjs"
			}
		}
	},
	"files": [
		"CHANGELOG.md",
		"audio-extensions.json",
		"index.cjs",
		"index.d.cts",
		"index.d.ts",
		"index.js",
		"license",
		"README.md"
	],
	"engines": {
		"node": ">=18"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/KikoPalomares/is-audio.git"
	},
	"bugs": {
		"url": "https://github.com/KikoPalomares/is-audio/issues"
	},
	"homepage": "https://github.com/KikoPalomares/is-audio#readme",
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"test": "node --test test/*.test.cjs test/*.test.mjs",
		"pack:dry-run": "npm pack --dry-run",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@types/node": "^24.0.0",
		"typescript": "^5.8.0"
	}
}
